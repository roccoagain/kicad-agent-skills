(version 1)
# JLCPCB recommended values and silkscreen legibility: 4-layer and bigger FR-4, 1 oz outer copper.
# JLC still builds a board that breaks these, but it may print poorly or yield worse: report them as
# warnings. Source: https://jlcpcb.com/capabilities/pcb-capabilities (read 2026-11-05).
# For 2 oz outer copper change the values marked [2oz].
#
# The limits first (the same rules as jlcpcb-multilayer-limits.kicad_dru), then the recommended
# values, which win because they come later.

# [2oz] 0.15mm
(rule "JLC copper clearance"
	(constraint clearance (min 0.09mm)))

# [2oz] 0.15mm
(rule "JLC track width"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.09mm)))

(rule "JLC copper to board edge"
	(constraint edge_clearance (min 0.2mm)))

# Unlike the limits file, the hole rules here keep JLC's 6.3 mm drill maximum: bigger holes are milled, a warning.
(rule "JLC hole size"
	(condition "A.Type == 'Pad' || A.Type == 'Via'")
	(constraint hole_size (min 0.15mm) (max 6.3mm)))

(rule "JLC NPTH hole size"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm) (max 6.3mm)))

(rule "JLC via diameter"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.25mm)))

(rule "JLC annular ring"
	(constraint annular_width (min 0.05mm)))

(rule "JLC hole to copper"
	(constraint hole_clearance (min 0.2mm)))

(rule "JLC inner-layer PTH hole to copper"
	(layer inner)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.3mm)))

(rule "JLC hole to hole"
	(constraint hole_to_hole (min 0.2mm)))

(rule "JLC pad hole to pad hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

# [2oz] 0.15mm
(rule "JLC pad to track"
	(condition "(A.Type == 'Pad' && B.Type == 'Track') || (A.Type == 'Track' && B.Type == 'Pad')")
	(constraint clearance (min 0.10mm)))

(rule "JLC SMD pad to SMD pad"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
	(constraint clearance (min 0.15mm)))

# Recommended values.

(rule "JLC rec via hole"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm) (max 6.3mm)))

(rule "JLC rec via ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.075mm)))

# [2oz] 0.254mm
(rule "JLC rec PTH ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.20mm)))

(rule "JLC rec PTH hole to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.35mm)))

(rule "JLC rec inner-layer PTH hole to copper"
	(layer inner)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.35mm)))

# Silkscreen legibility: 1.0 mm text, 0.15 mm strokes, 0.15 mm from pads and mask openings.

(rule "JLC rec silk text"
	(layer "F.SilkS")
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm)))

(rule "JLC rec silk text, back"
	(layer "B.SilkS")
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm)))

(rule "JLC rec silk to pads"
	(condition "A.Type == 'Pad' || B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))
